# ---------------------------------------------------------------------------
# Copy this file to .env and edit the marked lines.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---------- application ----------
APP_ENV=development
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=8000
SERVICE_NAME=noc-api

# ---------- database ----------
# EDIT THIS LINE. Format:
#   postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Replace USERNAME and PASSWORD with your own PostgreSQL credentials.
DATABASE_URL=postgresql://noc:noc_local_password@localhost:5432/noc_test

DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# ---------- artifacts ----------
# Folder the automation suite writes screenshots and logs into. The API serves
# files back from here, so both must be able to reach it.
ARTIFACTS_DIR=./artifacts

# ---------- CORS ----------
# Comma-separated origins allowed to call the API. The Vite dev server by
# default; add your deployed frontend origin here too.
CORS_ORIGINS=http://localhost:5173

# ---------- logging ----------
LOG_LEVEL=INFO

# ---------- retention ----------
# Months of run history kept before old partitions are dropped.
RETENTION_MONTHS=24
